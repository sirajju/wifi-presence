# HTTP listen address for the local API.
PRESENCE_LISTEN=127.0.0.1:8765

# Network interface to scan. "auto" picks the first non-loopback, non-tailscale UP interface.
PRESENCE_INTERFACE=auto

# Subnet to sweep. "auto" derives /24 from the chosen interface.
PRESENCE_SUBNET=auto

# SQLite database path. Relative paths resolve against the working directory.
PRESENCE_DB=./data/presence.db

# How often to run a scan cycle.
PRESENCE_POLL_INTERVAL=30s

# Device counts as HOME if seen within this window.
PRESENCE_HOME_WINDOW=90s

# Device counts as AWAY if not seen within this window.
PRESENCE_AWAY_WINDOW=5m

# Trim the events table to this many days.
PRESENCE_EVENT_RETENTION_DAYS=30

# info | debug | warn | error
PRESENCE_LOG_LEVEL=info
